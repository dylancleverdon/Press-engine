{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Press Engine",
  "version": "1.0.0",
  "identifier": "com.dylancleverdon.pressengine",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Find, pitch and keep track of music press and creators",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/bin/uv": "bin/uv",
      "resources/backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
