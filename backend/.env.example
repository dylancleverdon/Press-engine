# Copy to backend/.env and fill in what you have. Everything is optional except
# what the step you want to run needs; missing keys just skip that source.

# Where the SQLite database, Google token and logs live.
PRESS_DATA_DIR=./data
# PRESS_DATABASE_URL=sqlite:///./data/press_engine.db
# PRESS_DATABASE_URL=postgresql+psycopg://user:pass@localhost/press_engine

# Public URL of this backend (used in links shown to the phone/extension).
PRESS_BASE_URL=http://localhost:8000

# --- Discovery sources -------------------------------------------------------
# Last.fm API key (free): https://www.last.fm/api/account/create
PRESS_LASTFM_API_KEY=
# Web search: "brave" or "serpapi"
PRESS_SEARCH_PROVIDER=brave
PRESS_BRAVE_API_KEY=
PRESS_SERPAPI_API_KEY=
# YouTube Data API v3 key (free daily quota)
PRESS_YOUTUBE_API_KEY=
# Spotify app credentials (client-credentials flow) for playlist-curator search
PRESS_SPOTIFY_CLIENT_ID=
PRESS_SPOTIFY_CLIENT_SECRET=

# --- Local extraction model (spec §4.5) -------------------------------------
# provider: ollama | openai (any OpenAI-compatible server: llama.cpp, LM Studio, vLLM) | none
PRESS_EXTRACT_LLM_PROVIDER=ollama
PRESS_EXTRACT_LLM_MODEL=qwen2.5:3b
PRESS_EXTRACT_LLM_BASE_URL=http://localhost:11434

# --- Larger model for scoring, translation and reply drafts (spec §4.7) ------
# provider: none (heuristic scoring only) | ollama | openai | anthropic
PRESS_SCORE_LLM_PROVIDER=none
# e.g. qwen2.5:14b for ollama, or claude-opus-5-5 for anthropic
PRESS_SCORE_LLM_MODEL=
PRESS_SCORE_LLM_BASE_URL=
PRESS_SCORE_LLM_API_KEY=
# Anthropic only: low | medium | high (blank = API default)
PRESS_SCORE_LLM_EFFORT=
# For the anthropic provider you can also just set ANTHROPIC_API_KEY.

# --- Google (Gmail + Calendar) ----------------------------------------------
# OAuth client JSON downloaded from Google Cloud Console (Desktop app client)
PRESS_GOOGLE_CLIENT_SECRETS_FILE=./data/google_client_secret.json
PRESS_GOOGLE_TOKEN_FILE=./data/google_token.json

# --- Runtime -----------------------------------------------------------------
# Run the background scheduler (discovery, queue, drip sending, reply polling)
PRESS_SCHEDULER_ENABLED=true
# Be polite to websites: obey robots.txt and wait between requests to one host
PRESS_RESPECT_ROBOTS=true
PRESS_PER_HOST_DELAY_SECONDS=2
